            "    int n;",
            "    vector<long long> bit;",
            "    explicit Fenwick(int count) : n(count), bit(count + 1, 0) {}",
            "    void add(int i, long long delta) {",
            "        for (++i; i <= n; i += i & -i) bit[i] += delta;",
            "    }",
            "    long long prefix(int r) const { // Sum on [0, r).",
            "        long long res = 0;",
            "        for (; r > 0; r -= r & -r) res += bit[r];",
            "        return res;",
            "    }",
