            "    int n;",
            "    vector<long long> tree;",
            "    explicit SegTree(int count) : n(max(1, count)), tree(2 * n, 0) {}",
            "    void set(int i, long long value) {",
            "        i += n;",
            "        tree[i] = value;",
            "        for (i /= 2; i > 0; i /= 2) tree[i] = tree[2 * i] + tree[2 * i + 1];",
            "    }",
            "    long long sum(int l, int r) const {",
            "        long long res = 0;",
            "        for (l += n, r += n; l < r; l /= 2, r /= 2) {",
            "            if (l & 1) res += tree[l++];",
            "            if (r & 1) res += tree[--r];",
            "        }",
            "        return res;",
            "    }",
