    "CP: disjoint set union": {
        "scope": "cpp",
        "prefix": "dsu",
        "description": "Вставлять вне main/solve. DSU d(n); unite(a,b), find(v), size(v). Индексы с 0.",
        "body": [
            "struct DSU {",
            "    vector<int> parent, sz;",
            "    explicit DSU(int n) : parent(n), sz(n, 1) {",
            "        iota(parent.begin(), parent.end(), 0);",
            "    }",
            "    int find(int v) {",
            "        while (v != parent[v]) {",
            "            parent[v] = parent[parent[v]];",
            "            v = parent[v];",
            "        }",
            "        return v;",
            "    }",
            "    bool unite(int a, int b) {",
            "        a = find(a); b = find(b);",
            "        if (a == b) return false;",
            "        if (sz[a] < sz[b]) swap(a, b);",
            "        parent[b] = a;",
            "        sz[a] += sz[b];",
            "        return true;",
            "    }",
            "    int size(int v) { return sz[find(v)]; }",
            "};",
            "$0"
        ]
    },
