    "CP: Dijkstra distances": {
        "scope": "cpp",
        "prefix": "dijkstra",
        "description": "Вне main/solve. Граф vector<vector<pair<int,long long>>>. Веса >= 0, расстояния < LLONG_MAX/4.",
        "body": [
            "vector<long long> dijkstra(const vector<vector<pair<int, long long>>> &g, int start) {",
            "    const long long INF = numeric_limits<long long>::max() / 4;",
            "    vector<long long> dist(g.size(), INF);",
            "    using State = pair<long long, int>;",
            "    priority_queue<State, vector<State>, greater<State>> pq;",
            "    dist[start] = 0;",
            "    pq.push({0, start});",
            "    while (!pq.empty()) {",
            "        auto [d, v] = pq.top(); pq.pop();",
            "        if (d != dist[v]) continue;",
            "        for (auto [to, w] : g[v]) {",
            "            if (w >= INF - d || dist[to] <= d + w) continue;",
            "            dist[to] = d + w;",
            "            pq.push({dist[to], to});",
            "        }",
            "    }",
            "    return dist;",
            "}",
            "$0"
        ]
    },
